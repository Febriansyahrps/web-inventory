// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Role {
  id    Int    @id @default(autoincrement())
  name  String
  users User[]

  @@map("role")
}

model User {
  id        Int      @id @default(autoincrement())
  idRole    Int      @map("id_role")
  username  String   @unique
  password  String   // store bcryptjs hash later
  fullname  String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  role         Role          @relation(fields: [idRole], references: [id])
  barang       Barang[]
  activityLogs ActivityLog[]

  @@map("user")
}

model KategoriBarang {
  id     Int      @id @default(autoincrement())
  name   String
  barang Barang[]

  @@map("kategory_barang")
}

model LokasiBarang {
  id     Int      @id @default(autoincrement())
  name   String
  barang Barang[]

  @@map("lokasi_barang")
}

model KeadaanBarang {
  id     Int      @id @default(autoincrement())
  name   String
  barang Barang[]

  @@map("keadaan_barang")
}

model SatuanBarang {
  id     Int      @id @default(autoincrement())
  name   String
  barang Barang[]

  @@map("satuan_barang")
}

model AsalBarang {
  id     Int      @id @default(autoincrement())
  name   String
  barang Barang[]

  @@map("asal_barang")
}

model Barang {
  id               Int      @id @default(autoincrement())
  idUser           Int?     @map("id_user")
  idKategoriBarang Int?     @map("id_kategori_barang")
  idLokasiBarang   Int?     @map("id_lokasi_barang")
  idAsalBarang     Int?     @map("id_asal_barang")
  idKeadaanBarang  Int?     @map("id_keadaan_barang")
  idSatuanBarang   Int?     @map("id_satuan_barang")
  kodeBarang       String   @map("kode_barang")
  noRegister       String   @map("no_register")
  namaBarang       String   @map("nama_barang")
  merkBarang       String?  @map("merk_barang")
  noSertifikat     String?  @map("no_sertifikat")
  bahan            String?
  tahunPerolehan   Int?     @map("tahun_perolehan")
  ukuranBarang     String?  @map("ukuran_barang")
  jumlahBarang     Int      @map("jumlah_barang")
  hargaBarang      Decimal  @map("harga_barang") @db.Decimal(18, 2)
  fotoBarang       String?  @map("foto_barang")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  user           User?           @relation(fields: [idUser], references: [id], onDelete: SetNull)
  kategoriBarang KategoriBarang? @relation(fields: [idKategoriBarang], references: [id], onDelete: SetNull)
  lokasiBarang   LokasiBarang?   @relation(fields: [idLokasiBarang], references: [id], onDelete: SetNull)
  asalBarang     AsalBarang?     @relation(fields: [idAsalBarang], references: [id], onDelete: SetNull)
  keadaanBarang  KeadaanBarang?  @relation(fields: [idKeadaanBarang], references: [id], onDelete: SetNull)
  satuanBarang   SatuanBarang?   @relation(fields: [idSatuanBarang], references: [id], onDelete: SetNull)

  @@map("barang")
}

model ActivityLog {
  id        Int      @id @default(autoincrement())
  idUser    Int?     @map("id_user")
  action    String   // CREATE | UPDATE | DELETE | DOWNLOAD | EMAIL
  entity    String   // BARANG | USER | BACKUP
  entityId  Int?     @map("entity_id")
  label     String   // denormalized name, e.g. "Kursi Kayu" / "admin"
  detail    Json?    // reserved for future before/after snapshot — not populated yet
  createdAt DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [idUser], references: [id], onDelete: SetNull)

  @@map("activity_log")
}
